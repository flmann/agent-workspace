# Directory mounted as /home/agent (persists logins, config, sessions, history).
AGENT_HOME=${HOME}/Docker/agent-workspace/home

# Match your host user and group (`id -u`, `id -g`)
AGENT_UID=1000
AGENT_GID=1000

# Resource limits
AGENT_MEM_LIMIT=8g
AGENT_CPUS=4

TZ=Europe/Berlin

# All agents installed by default, set to false skips install
# INSTALL_CLAUDE=false
# INSTALL_CODEX=false
# INSTALL_OPENCODE=false
# INSTALL_OMP=false

# FreeCAD MCP server, not installed by default
# INSTALL_FREECAD_MCP=true

# Optional. Leave empty to log in interactively inside the container.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SCADSAI_API_KEY=
GH_TOKEN=
GITLAB_TOKEN=
