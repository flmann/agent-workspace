# Copy to .env and adjust.

# Directory mounted as /home/agent (persists logins, config, history).
# Must exist before the first run: mkdir -p "$HOME/Docker/agent/home"
AGENT_HOME=${HOME}/Docker/agent/home

# uid/gid of the 'agent' user, build-time. Match your host user (`id -u`, `id -g`)
# so files created in the workspace are owned by you. Rebuild after changing.
AGENT_UID=1000
AGENT_GID=1000

# Resource limits
AGENT_MEM_LIMIT=4g
AGENT_CPUS=2

TZ=Europe/Berlin

# Credentials, all optional. Leave empty to log in interactively inside the container.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SCADSAI_API_KEY=
GH_TOKEN=
GITLAB_TOKEN=
